      "source": [
        "best = onset_eval.iloc[1:].sort_values('MAE_days').iloc[0]['method'].replace('Onset ', '')\n",
        "print('Best onset rule:', best)\n",
        "fig, ax = plt.subplots(1, 2, figsize=(13, 4.8))\n",
        "x = (trials[best] - trials.season_start).dt.days\n",
        "for c, m in [('Malawi', 'o'), ('Zambia', 's')]:\n",
        "    s = trials.country == c\n",
        "    ax[0].scatter(x[s], trials.sow_day[s], marker=m, label=c, alpha=0.8)\n",
        "lim = [x.min() - 5, max(x.max(), trials.sow_day.max()) + 5]\n",
        "ax[0].plot(lim, lim, 'k--', lw=0.8, label='sowing = onset')\n",
        "ax[0].set_xlabel('Predicted onset (days after 1 Oct)'); ax[0].set_ylabel('Recorded sowing (days after 1 Oct)')\n",
        "ax[0].set_title(f'Onset vs sowing — rule {best[:1]}'); ax[0].legend()\n",
        "trials[best + ' | gap'].plot.hist(bins=20, ax=ax[1], edgecolor='k')\n",
        "ax[1].axvline(trials[best + ' | gap'].median(), color='r', ls='--', label='median gap')\n",
        "ax[1].set_xlabel('Sowing minus onset (days)'); ax[1].set_title('Gap between onset and sowing'); ax[1].legend()\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "print('Largest disagreements (sowing far from onset):')\n",
        "g = trials.assign(gap=trials[best + ' | gap']).dropna(subset=['gap'])\n",
        "display(g.reindex(g.gap.abs().sort_values(ascending=False).index)[['env', 'country', 'loc', 'year', 'water', 'sowing', best, 'gap']].head(8))"
      ]
    },
