        "import os, time, warnings, subprocess, sys\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from concurrent.futures import ThreadPoolExecutor\n",
        "warnings.filterwarnings('ignore')\n",
        "pd.set_option('display.width', 200); plt.rcParams['figure.dpi'] = 110\n",
        "try:\n",
        "    import rasterio\n",
        "except ImportError:\n",
        "    subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', 'rasterio'], check=True)\n",
        "    import rasterio\n",
        "\n",
        "# ---------------- SETTINGS ----------------\n",
        "CSV_PATH    = 'PAT_Soybean_Rust_Database_MT4.csv'   # MT2 also works\n",
        "DATE_FORMAT = 'auto'\n",
        "COUNTRIES   = ['Malawi', 'Zambia']\n",
        "WATER       = ['Rainfed', 'Supplementary']          # planting driven by rain\n",
        "SEARCH_FROM = (11, 1)     # onset search starts 1 November of the season year\n",
        "SEARCH_TO   = (2, 28)     # ... and ends 28 February of the next year\n",
        "DRY_DAY_MM  = 1.0         # a day with < 1 mm counts as dry\n",
        "CACHE_DIR   = 'weather_cache'\n",
        "\n",
        "# Onset rules to test: rain needed (mm) over a number of days, and the longest dry spell allowed\n",
        "# in the following days (None = no false-start check).\n",
        "RULES = {\n",
        "    'A: 25 mm in 3 days, no 10-day dry spell in next 30': dict(mm=25, days=3, dry_len=10, look=30),\n",
        "    'B: 20 mm in 3 days, no 7-day dry spell in next 30':  dict(mm=20, days=3, dry_len=7,  look=30),\n",
        "    'C: 25 mm in 3 days (no false-start check)':          dict(mm=25, days=3, dry_len=None, look=30),\n",
        "}\n",
        "os.makedirs(CACHE_DIR, exist_ok=True)"
      ]
    },
