        "id": "0f3e9418"
      },
      "source": [
        "## 2. Daily CHIRPS rainfall at the trial sites\n",
        "\n",
        "Each day's CHIRPS file is read directly from the Climate Hazards Center, taking only the pixels at the trial sites (1 October to 31 March of each season)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "id": "6ed66698",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "6ed66698",
        "outputId": "4da712b5-eac1-45bf-9143-eebc0aff7a20"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "55 sites, 1458 days read in 70 s | days with no data: 0\n"
          ]
        }
      ],
      "source": [
        "CHC_URL = 'https://data.chc.ucsb.edu/products/CHIRPS-2.0/global_daily/cogs/p05/{d:%Y}/chirps-v2.0.{d:%Y.%m.%d}.cog'\n",
        "cdir = os.path.join(CACHE_DIR, 'chirps_onset'); os.makedirs(cdir, exist_ok=True)\n",
        "sites = trials[['lat', 'lon']].drop_duplicates().reset_index(drop=True)\n",
        "sites['site'] = [f's{i}' for i in range(len(sites))]\n",
        "trials = trials.merge(sites, on=['lat', 'lon'])\n",
        "points = list(zip(sites.lon, sites.lat))\n",
        "GDAL_ENV = dict(GDAL_DISABLE_READDIR_ON_OPEN='EMPTY_DIR', CPL_VSIL_CURL_ALLOWED_EXTENSIONS='.cog,.tif',\n",
        "                GDAL_HTTP_MAX_RETRY='4', GDAL_HTTP_RETRY_DELAY='3')\n",
        "\n",
        "def chirps_day(day):\n",
        "    path = os.path.join(cdir, f'{day:%Y%m%d}.csv')\n",
        "    if os.path.exists(path):\n",
        "        return pd.read_csv(path)\n",
        "    try:\n",
        "        with rasterio.Env(**GDAL_ENV):\n",
        "            with rasterio.open(CHC_URL.format(d=day)) as src:\n",
        "                vals = [float(v[0]) for v in src.sample(points)]; nod = src.nodata\n",
        "        vals = [np.nan if (nod is not None and v == nod) or v < 0 else v for v in vals]\n",
        "        out = pd.DataFrame({'site': sites.site, 'precip': vals}); out.to_csv(path, index=False)\n",
        "        return out\n",
        "    except Exception:\n",
        "        return pd.DataFrame({'site': sites.site, 'precip': np.nan})\n",
        "\n",
        "days = sorted({d for y in trials.year.unique()\n",
        "                 for d in pd.date_range(f'{y}-10-01', f'{y + 1}-03-31', freq='D')})\n",
        "t0 = time.time()\n",
        "with ThreadPoolExecutor(max_workers=8) as pool:\n",
        "    res = list(pool.map(chirps_day, days))\n",
        "rain = pd.concat([r.assign(date=d) for r, d in zip(res, days)]).pivot(index='date', columns='site', values='precip')\n",
        "missing = rain.isna().all(axis=1)\n",
        "print(f'{len(sites)} sites, {len(days)} days read in {time.time() - t0:.0f} s | days with no data: {missing.sum()}')"
      ]
    },
