        "## 1. Trials and their recorded sowing dates\n",
        "\n",
        "Same date reading and fixes as the main pipeline. All trials are kept here (including those not assessed for rust),\n",
        "because their **sowing dates** are still valid."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "id": "1dac9ba7",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "1dac9ba7",
        "outputId": "30ce2ab6-b007-4c1c-8159-61e3f75fe633"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "60 trials: {'Malawi': 36, 'Zambia': 24} | {'Rainfed': 52, 'Supplementary': 8}\n",
            "Sowing: median 81 days after 1 Oct (21 Dec), spread (SD) 11 days, earliest 05 Dec 2019, latest 01 Feb 2018\n"
          ]
        }
      ],
      "source": [
        "raw = pd.read_csv(CSV_PATH); df = raw.copy()\n",
        "\n",
        "def detect_format(cols):\n",
        "    ok = [f for f in ['%m/%d/%Y', '%d/%m/%Y']\n",
        "          if all(pd.to_datetime(df[c].astype(str).str.strip(), format=f, errors='coerce').notna().all() for c in cols)]\n",
        "    if len(ok) != 1:\n",
        "        raise ValueError(f'Cannot decide the date layout ({ok}); set DATE_FORMAT by hand.')\n",
        "    return ok[0]\n",
        "fmt = detect_format(['SOWING', 'HARVEST']) if DATE_FORMAT == 'auto' else DATE_FORMAT\n",
        "for c in ['SOWING', 'HARVEST']:\n",
        "    df[c] = pd.to_datetime(df[c].astype(str).str.strip(), format=fmt)\n",
        "shift = df['SOWING'] > pd.to_datetime((df['YEAR'] + 1).astype(str) + '-03-31')\n",
        "df.loc[shift, ['SOWING', 'HARVEST']] = df.loc[shift, ['SOWING', 'HARVEST']] - pd.DateOffset(years=1)\n",
        "\n",
        "df = df[df.COUNTRY.isin(COUNTRIES) & (df.SEASON == 2) & df.RAINFED.isin(WATER)]\n",
        "trials = (df.groupby('env').agg(country=('COUNTRY', 'first'), loc=('loc', 'first'), year=('YEAR', 'first'),\n",
        "                                water=('RAINFED', 'first'), lat=('LAT', 'first'), lon=('LON', 'first'),\n",
        "                                sowing=('SOWING', 'min')).reset_index())\n",
        "trials['season_start'] = pd.to_datetime(trials.year.astype(str) + '-10-01')\n",
        "trials['sow_day'] = (trials.sowing - trials.season_start).dt.days      # days after 1 October\n",
        "print(f'{len(trials)} trials:', trials.country.value_counts().to_dict(), '|', trials.water.value_counts().to_dict())\n",
        "print(f'Sowing: median {trials.sow_day.median():.0f} days after 1 Oct '\n",
        "      f'({(pd.Timestamp(\"2000-10-01\") + pd.Timedelta(days=trials.sow_day.median())):%d %b}), '\n",
        "      f'spread (SD) {trials.sow_day.std():.0f} days, earliest {trials.loc[trials.sow_day.idxmin(), \"sowing\"]:%d %b %Y}, '\n",
        "      f'latest {trials.loc[trials.sow_day.idxmax(), \"sowing\"]:%d %b %Y}')"
      ]
    },
