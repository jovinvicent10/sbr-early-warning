      "source": [
        "## 3. Season onset at each trial\n",
        "\n",
        "For each trial, the onset is the **first day from 1 November** on which the rule's rain total is reached over the rule's number of days,\n",
        "**and** (for rules A and B) no dry spell of the given length follows in the next 30 days. Dry spell = consecutive days with < 1 mm."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "id": "973fe5a6",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "973fe5a6",
        "outputId": "bf205485-efb0-4576-9ca0-3477377582ef"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "A: 25 mm in 3 days, no 10-day dry spell in next 30: onset found for 100% of trials, median onset 30 Nov\n",
            "B: 20 mm in 3 days, no 7-day dry spell in next 30: onset found for 100% of trials, median onset 30 Nov\n",
            "C: 25 mm in 3 days (no false-start check): onset found for 100% of trials, median onset 30 Nov\n"
          ]
        }
      ],
      "source": [
        "def longest_dry_run(r):\n",
        "    dry = (r < DRY_DAY_MM).astype(int).values\n",
        "    best = run = 0\n",
        "    for v in dry:\n",
        "        run = run + 1 if v else 0; best = max(best, run)\n",
        "    return best\n",
        "\n",
        "def onset(series, year, mm, days, dry_len, look):\n",
        "    r = series.fillna(0)\n",
        "    wet = r.rolling(days).sum().shift(-(days - 1))          # rain on day d plus the next (days-1) days\n",
        "    start = pd.Timestamp(year, *SEARCH_FROM); end = pd.Timestamp(year + 1, *SEARCH_TO)\n",
        "    for d in pd.date_range(start, end):\n",
        "        if wet.get(d, 0) >= mm:\n",
        "            if dry_len is None:\n",
        "                return d\n",
        "            after = r[d + pd.Timedelta(days=1): d + pd.Timedelta(days=look)]\n",
        "            if longest_dry_run(after) < dry_len:\n",
        "                return d\n",
        "    return pd.NaT\n",
        "\n",
        "for name, p in RULES.items():\n",
        "    trials[name] = [onset(rain[r.site], r.year, **p) for _, r in trials.iterrows()]\n",
        "    trials[name + ' | gap'] = (trials.sowing - trials[name]).dt.days      # sowing minus onset (days)\n",
        "    found = trials[name].notna().mean()\n",
        "    print(f'{name}: onset found for {found:.0%} of trials, median onset '\n",
        "          f'{(pd.Timestamp(\"2000-10-01\") + pd.Timedelta(days=(trials[name] - trials.season_start).dt.days.median())):%d %b}')"
      ]
    },
    {
