      "source": [
        "from scipy.stats import spearmanr\n",
        "\n",
        "def evaluate(pred_fn, label):\n",
        "    pred = pd.Series(index=trials.index, dtype=float)\n",
        "    for y in trials.year.unique():\n",
        "        te, tr = trials.year == y, trials.year != y\n",
        "        pred[te] = pred_fn(trials[tr], trials[te])\n",
        "    ok = pred.notna()\n",
        "    err = (pred[ok] - trials.sow_day[ok]).abs()\n",
        "    return {'method': label, 'trials': int(ok.sum()), 'MAE_days': round(err.mean(), 1),\n",
        "            'within_10d': f'{(err <= 10).mean():.0%}', 'within_14d': f'{(err <= 14).mean():.0%}',\n",
        "            'spearman': round(spearmanr(pred[ok], trials.sow_day[ok])[0], 2)}, pred\n",
        "\n",
        "rows, preds = [], {}\n",
        "r, preds['Fixed date'] = evaluate(lambda tr, te: np.full(len(te), tr.sow_day.median()), 'Fixed typical date')\n",
        "rows.append(r)\n",
        "for name in RULES:\n",
        "    def fn(tr, te, name=name):\n",
        "        gap = tr[name + ' | gap'].median()\n",
        "        return ((te[name] - te.season_start).dt.days + gap).values\n",
        "    r, preds[name] = evaluate(fn, 'Onset ' + name)\n",
        "    r['median_gap_days'] = trials[name + ' | gap'].median()\n",
        "    rows.append(r)\n",
        "onset_eval = pd.DataFrame(rows)\n",
        "display(onset_eval)"
      ]
    },
